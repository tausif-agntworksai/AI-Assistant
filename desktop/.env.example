# Copy this file to `.env`. These values are public-by-design — a Firebase web
# app config is meant to be shipped, and the protection comes from Firebase's
# own rules plus the checks in src/auth/session.ts, not from hiding them.
#
# Leaving them blank runs Jarvis WITHOUT sign-in and says so on screen, which
# is the right state while you're still setting Firebase up.
#
# Where to find these: Firebase console → Project settings → Your apps → Web
# app → SDK setup and configuration. Pointing this at the same project as the
# AI Calculator means one account and one approval for both applications.

JARVIS_FIREBASE_API_KEY=
JARVIS_FIREBASE_AUTH_DOMAIN=
JARVIS_FIREBASE_PROJECT_ID=
JARVIS_FIREBASE_APP_ID=

# Enforce the gate: verified email, admin approval, and (when enabled below)
# an authenticator app. Set to false to keep the sign-in screen but stop it
# blocking the assistant.
JARVIS_REQUIRE_AUTH=true

# Two-step verification (TOTP). Needs the Firebase Blaze plan — leave this
# false on the free plan and the rest of the flow still applies.
JARVIS_ENABLE_2FA=false

# Comma- or space-separated admin emails. These accounts skip the approval
# queue. Deliberately withheld from packaged builds (see
# scripts/make-app-env.mjs), so a copy you hand out can't inherit your
# allowlist.
JARVIS_ADMIN_EMAILS=
