# Copy this file to `.env`. These values are public-by-design — a Firebase web
# app config is meant to be shipped, and the protection comes from Firebase's
# own rules plus the checks in src/auth/session.ts, not from hiding them.
#
# Leaving them blank runs Jarvis WITHOUT sign-in and says so on screen, which
# is the right state while you're still setting Firebase up.
#
# Where to find these: Firebase console → Project settings → Your apps → Web
# app → SDK setup and configuration. Pointing this at the same project as
# another app means one account signs in to both.

JARVIS_FIREBASE_API_KEY=
JARVIS_FIREBASE_AUTH_DOMAIN=
JARVIS_FIREBASE_PROJECT_ID=
JARVIS_FIREBASE_APP_ID=

# Enforce the gate: verified email, then an authenticator app, before the
# microphone opens. Accounts are self-serve; nobody approves anybody.
#
# Two-step verification is always required when this is on, and TOTP needs the
# Firebase **Blaze** plan (billing account attached; no per-use charge at this
# volume). Setting this to false is for local development only — it leaves the
# sign-in screen in place but stops it gating the assistant.
JARVIS_REQUIRE_AUTH=true
