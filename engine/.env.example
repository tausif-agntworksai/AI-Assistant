# Copy to .env and fill in. NEVER commit .env.

# Required from Phase 5 onward (conversation, Q&A, translation, and the
# fallback that understands commands the local rules don't recognise).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional cloud speech-to-text fallback. Leave blank to stay fully local.
# Supported: openai | deepgram
CLOUD_STT_PROVIDER=
CLOUD_STT_API_KEY=

# Optional — weather skill (https://openweathermap.org/api, free tier)
OPENWEATHER_API_KEY=
